rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas base
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Usuarios
    match /usuarios/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin');
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin');
    }
    
    // Empresas
    match /empresas/{empresaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
    
    // Peligros
    match /peligros/{peligroId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'responsable_sst']);
    }
    
    // Acciones
    match /acciones/{accionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'responsable_sst']);
    }
    
    // Trabajadores
    match /trabajadores/{trabajadorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'responsable_sst', 'jefe_area']);
    }
    
    // Incidentes
    match /incidentes/{incidenteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'responsable_sst']);
    }
    
    // Logs
    match /logs/{logId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
      allow write: if request.auth != null;
    }
  }
}
